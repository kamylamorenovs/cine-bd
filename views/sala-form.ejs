<%- include('partials/cabecera', { titulo }) %>
<% const editando = sala && sala.id; %>
<h1><%= editando ? 'Editar sala' : 'Nueva sala' %></h1>
<% if (error) { %><p class="aviso error"><%= error %></p><% } %>
<form class="formulario" method="post" action="<%= editando ? '/vistas/salas/' + sala.id + '/editar' : '/vistas/salas' %>">
  <label>Nombre
    <input type="text" name="nombre" required value="<%= sala ? sala.nombre : '' %>">
  </label>
  <label>Capacidad (personas)
    <input type="number" name="capacidad" min="1" required value="<%= sala ? sala.capacidad : '' %>">
  </label>
  <label>Tipo
    <select name="tipo" required>
      <% ['2D', '3D', 'IMAX'].forEach((t) => { %>
      <option value="<%= t %>" <%= sala && sala.tipo === t ? 'selected' : '' %>><%= t %></option>
      <% }) %>
    </select>
  </label>
  <div class="acciones">
    <button class="boton" type="submit">Guardar</button>
    <a class="boton secundario" href="/vistas/salas">Cancelar</a>
  </div>
</form>
<%- include('partials/pie') %>
